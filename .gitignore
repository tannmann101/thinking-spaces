node_modules/
dist/
*.log

# The deleted Express backend's local SQLite file and uploads. backend/
# itself is gone, but this stays: `git pull` doesn't remove an ignored
# folder, so an existing clone keeps its old backend/data/ on disk. It's
# harmless where it sits, and it is not something to commit if anyone
# ever goes looking in it.
backend/data/
.DS_Store

# The one-time hosting-migration dump of the real personal database,
# written by the export-to-d1 script that shipped with the old Express
# backend. The script is gone; an old dump may still be sitting in a
# clone, and it is never something to commit.
data-export.sql

# Written by DEPLOY.md's pre-migration backup step -- a full dump of the
# real deployed database. Same reasoning as data-export.sql above.
backup-before-migration.sql
